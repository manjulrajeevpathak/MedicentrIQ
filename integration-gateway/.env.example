PORT=4105
HOST=127.0.0.1

# Optional for local demos. Required when NODE_ENV=production.
# When unset outside production, the service runs in demo auth mode.
SERVICE_API_KEY=

# Optional. When set, normalized events are forwarded here:
# ${CORE_API_URL}/service-events/integration
CORE_API_URL=http://127.0.0.1:4199

# Meta WhatsApp Cloud webhooks (tenant-suffixed public routes):
#   GET/POST /webhooks/meta/whatsapp/<tenantId>
# The gateway must be publicly reachable over HTTPS for Meta to deliver events
# (dev: `cloudflared tunnel --url http://localhost:4105`). SERVICE_API_KEY must
# match core-api's CORE_API_SERVICE_KEY so forwarded webhooks authenticate.
