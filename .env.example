# ── MedicentrIQ docker-compose environment ────────────────────────────────────
# Copy to `.env` (git-ignored) and edit. Every value has a working default, so
# `docker compose up` runs out of the box — but the demo secrets below MUST be
# replaced before exposing this to anything but your own machine.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=healthcareos
POSTGRES_PASSWORD=healthcareos          # change me
POSTGRES_DB=healthcareos_core
DATABASE_POOL_SIZE=5

# ── Secrets — CHANGE ALL OF THESE for any non-local deployment ────────────────
# core-api seeds demo staff/admin accounts + these keys into an empty database.
STAFF_SESSION_SECRET=dev_session_secret_change_me_in_production   # long random string
PLATFORM_API_KEY=platform_demo_key            # superadmin (platform-console) key
CORE_API_SERVICE_KEY=core_demo_service_key    # gateway -> core-api auth (must match)
WORKFLOW_SERVICE_API_KEY=workflow_demo_service_key
SESSION_TTL_SECONDS=28800

# Demo header auth — keep false in production.
ALLOW_DEMO_AUTH_FALLBACK=false
DEMO_TENANT_ID=org_demo_healthcare
DEMO_USER_ID=user_demo_frontdesk

# ── Public URLs (used in invite / reset emails + confirm deep-links) ──────────
# For a real deployment set these to your externally-reachable hostnames.
STAFF_WEB_URL=http://localhost:3000/staff
PATIENT_WEB_URL=http://localhost:3000/care
PLATFORM_CONSOLE_URL=http://localhost:3000/console

# ── Optional: WhatsApp assistant / OCR (unset = assistant disabled) ───────────
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-4-5-20251001
OCR_MODEL=claude-sonnet-5

# ── Optional: S3 document storage (unset = local-disk fallback volume) ────────
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Optional: real email (unset = console transport; OTP/links logged) ────────
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=HealthOS

# ── Optional: host port overrides (defaults shown) ────────────────────────────
# WEB_PORT=3000
# CORE_API_PORT=4100
# WORKFLOW_WORKER_PORT=4104
# INTEGRATION_GATEWAY_PORT=4105
# POSTGRES_PORT=5432

# ── Advanced: browser-facing core-api URL per app ─────────────────────────────
# The web app calls core-api server-side over the compose network, so the internal
# URL (http://core-api:4100) is correct and baked in at build time. Only override
# if you change the internal topology.
# WEB_CORE_API_URL=http://core-api:4100

# ── Meta WhatsApp webhook ─────────────────────────────────────────────────────
# The webhook (/webhooks/meta/whatsapp/<tenant>) is served by the integration-gateway
# on :4105, but the web app PROXIES it same-origin (see next.config.mjs), so by default
# the callback URL lives on the app's OWN domain — Channels shows it automatically, no
# ALB rule and nothing to set here.
#
# GATEWAY_INTERNAL_URL — internal address the proxy forwards to; defaults to the compose
# service name. Only override if you change the internal topology.
# GATEWAY_INTERNAL_URL=http://integration-gateway:4105
#
# NEXT_PUBLIC_GATEWAY_URL — set ONLY if you host the gateway on a SEPARATE domain
# (e.g. gateway.<domain>) instead of proxying same-origin. Baked at build time.
# NEXT_PUBLIC_GATEWAY_URL=https://gateway.24elevenhealthcare.com
