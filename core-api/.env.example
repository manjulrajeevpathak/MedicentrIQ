PORT=4100
HOST=127.0.0.1

# When DATABASE_URL is unset, core-api uses in-memory seed data.
# Set this to enable PostgreSQL persistence.
DATABASE_URL=postgres://healthcareos:healthcareos@127.0.0.1:5432/healthcareos_core
DATABASE_POOL_SIZE=5
DATABASE_SSL=false

# Demo staff auth. Requests should pass x-demo-tenant-id and x-demo-user-id.
# Set ALLOW_DEMO_AUTH_FALLBACK=true only for local demos that intentionally
# default missing headers to DEMO_TENANT_ID/DEMO_USER_ID.
DEMO_TENANT_ID=org_demo_healthcare
DEMO_USER_ID=user_demo_frontdesk
ALLOW_DEMO_AUTH_FALLBACK=false

# Inbound service-to-service auth. The seeded demo key is core_demo_service_key.
# CORE_API_SERVICE_KEY can be used for environment-managed integration service calls.
CORE_API_SERVICE_KEY=core_demo_service_key

# Platform tier — HealthOS superadmin authenticates with this key via the
# x-platform-api-key header (used by the platform-console superadmin app).
PLATFORM_API_KEY=platform_demo_key

# Session signing secret (required for real login). Strong random value in prod.
STAFF_SESSION_SECRET=dev_session_secret_change_me_in_production
SESSION_TTL_SECONDS=28800

# App URLs used in invite / password-reset email links.
STAFF_WEB_URL=http://localhost:3200
PLATFORM_CONSOLE_URL=http://localhost:3202

# Email. Unset → console transport (OTP/links logged + GET /auth/dev/outbox in non-prod).
# Set to a Gmail/Workspace account + App Password to send real email:
# GMAIL_USER=info@finclarity.ai
# GMAIL_APP_PASSWORD=
# GMAIL_FROM_NAME=HealthOS

# Optional outbound wiring. If unset, core-api keeps graceful local fallback behavior.
WORKFLOW_WORKER_URL=http://127.0.0.1:4200
WORKFLOW_SERVICE_API_KEY=workflow_demo_service_key
